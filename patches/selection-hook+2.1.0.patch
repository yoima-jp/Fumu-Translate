+void SelectionHook::ProcessStringArrayToList(
+    const Napi::Array &array, std::vector<std::string> &targetList) {
+  uint32_t length = array.Length();
+
+  // Clear existing list
+  targetList.clear();
+
+  // Process each string in the array
+  for (uint32_t i = 0; i < length; i++) {
+    Napi::Value value = array.Get(i);
+    if (value.IsString()) {
+      // Get the UTF-8 string
+      std::string programName = value.As<Napi::String>().Utf8Value();
+
+      // Convert to lowercase
+      std::transform(programName.begin(), programName.end(),
+                     programName.begin(),
+                     [](unsigned char c) { return std::tolower(c); });
+
+      // Add to the target list (store as UTF-8)
+      targetList.push_back(programName);
