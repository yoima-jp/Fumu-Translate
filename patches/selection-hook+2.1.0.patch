+  const SIZE_T bytes = GlobalSize(data);
+  if (bytes < sizeof(wchar_t) || bytes > kMaxClipboardTextBytes ||
+      bytes % sizeof(wchar_t) != 0)
+    return false;
+
+  const wchar_t *text = static_cast<const wchar_t *>(GlobalLock(data));
+  if (!text)
+    return false;
